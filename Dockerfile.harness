FROM python:3.12-slim
WORKDIR /app
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
RUN pip install --no-cache-dir 'deepseek-harness-sdk==0.2.2rc2' && useradd --create-home --uid 10001 assistant
COPY harness_runtime/server.py harness_runtime/profile.yml ./
USER assistant
CMD ["python", "server.py"]
