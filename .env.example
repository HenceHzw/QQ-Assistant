# Your usual QQ number; use a separate QQ account to log in to NapCat.
OWNER_QQ=123456789
# Generate separate strong random values for both tokens.
NAPCAT_WEBUI_TOKEN=replace_with_random_webui_token
ONEBOT_TOKEN=replace_with_random_onebot_token
# QQ Mail IMAP authorization code, not your QQ password.
QQ_MAIL_AUTH_CODE=replace_with_qq_mail_authorization_code
# Optional additional mailbox credentials must match password_env in mailboxes.json.
# OTHER_MAIL_AUTH_CODE=replace_me
MAIL_POLL_SECONDS=120
# DeepSeek API credentials for Harness. Replace with your own values.
LLM_API_KEY=replace_me
LLM_MODEL=deepseek-flash

# Optional: OpenAI-compatible chat-completions endpoint when not using Harness.
# LLM_URL=https://your-provider.example/v1/chat/completions

# Optional DeepSeek Harness bridge authentication, generate a separate random value.
# HARNESS_AUTH_TOKEN=replace_me
